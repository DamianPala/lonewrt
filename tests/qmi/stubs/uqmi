#!/bin/sh
set -eu

# A client file holds its selected family. A call file holds the owning CID, the signed handle and
# whether it started with autoconnect, separately so releasing a client cannot silently erase an
# active call. Profile 1 lives in profile.apn, profile.pdp and profile.off (APN disabled).
# $state/fault holds fault lines "MATCH|ACTION|SKIP|TIMES" (see inject); $state/uptime is the clock
# the handler reads (LW_UPTIME_FILE), moved only by the faults slow and hang.
state=$QMI_STATE
clients=$state/clients
calls=$state/calls

joined=$*
argv=$(
    # jshn uses unset variables and the status of arithmetic commands internally.
    set +eu
    # shellcheck source=/dev/null
    . /usr/share/libubox/jshn.sh
    json_init
    json_add_array argv
    for arg do json_add_string "" "$arg"; done
    json_close_array
    json_dump
)
printf '%s\n' "$argv" >>"$state/uqmi.jsonl"

unsupported() {
    printf 'unsupported uqmi invocation (%s): %s\n' "$1" "$argv" |
        tee -a "$state/unexpected" >&2
    exit 2
}

qmi_error() {
    printf '"%s"\n' "$1"
    exit 1
}

clock_add() {
    read -r now _ <"$state/uptime"
    now=${now%%.*}
    printf '%s.00 %s.00\n' "$((now + $1))" "$((now + $1))" >"$state/uptime"
}

# inject: the faults of this call. ACTION is error:TEXT (a QMI error), reply:TEXT (an answer with
# status 0), hang (no answer in the call's -t: the clock moves by it), block (no answer ever: the
# caller's own limit has to kill it), slow:N (the call takes N s, then goes on), kill (the handler
# is killed now), lose (the call is made, its answer is lost), nostick (a profile write that is not
# kept). The fault applies from its SKIP+1st
# match, TIMES times (0: always).
nostick=0
inject() {
    [ -f "$state/fault" ] || return 0
    tms=1000
    prev=
    for a in "$@"; do
        [ "$prev" != -t ] || tms=$a
        prev=$a
    done
    n=0
    while IFS='|' read -r match action skip times; do
        n=$((n + 1))
        case $joined in *"$match"*) ;; *) continue ;; esac
        c=0
        [ ! -f "$state/fault.$n" ] || c=$(cat "$state/fault.$n")
        c=$((c + 1))
        printf '%s\n' "$c" >"$state/fault.$n"
        [ "$c" -gt "${skip:-0}" ] || continue
        [ "${times:-0}" = 0 ] || [ "$c" -le $((${skip:-0} + times)) ] || continue
        case $action in
            error:*) qmi_error "${action#error:}" ;;
            reply:*) printf '%s\n' "${action#reply:}"; exit 0 ;;
            hang) clock_add $((tms / 1000)); exit 1 ;;
            block) exec sleep 30 ;;
            slow:*) clock_add "${action#slow:}" ;;
            lose) exec >/dev/null ;;
            kill) kill -KILL "$(cat "$state/handler.pid")"; exit 137 ;;
            nostick) nostick=1 ;;
            *) unsupported 'fault action' ;;
        esac
    done <"$state/fault"
}

allocate_client() {
    if [ -f "$state/cid-limit" ]; then
        active=$(find "$clients" -type f | wc -l)
        [ "$active" -lt "$(cat "$state/cid-limit")" ] || qmi_error 'Client IDs exhausted'
    fi
    next=$(cat "$state/next-cid")
    printf '%s\n' "$((next + 1))" >"$state/next-cid"
    : >"$clients/$next"
    printf '%s\n' "$next"
}

profile_write() {
    [ "$1" = 3gpp,1 ] && [ "$2" = --apn ] && [ "$4" = --pdp-type ] ||
        unsupported 'profile arguments'
    case $5 in ipv4 | ipv6 | ipv4v6) ;; *) unsupported 'PDP type' ;; esac
    if [ "$nostick" = 0 ]; then
        printf '%s\n' "$3" >"$state/profile.apn"
        printf '%s\n' "$5" >"$state/profile.pdp"
        # a stock modify also clears the APN-disabled flag
        rm -f "$state/profile.off"
    fi
}

profile_read() {
    [ "$1" = 3gpp,1 ] || unsupported 'profile number'
    [ -f "$state/profile.pdp" ] || qmi_error 'Invalid profile'
    apn=$(cat "$state/profile.apn")
    off=false
    [ ! -e "$state/profile.off" ] || off=true
    # uqmi leaves an empty APN out
    printf '{'
    [ -z "$apn" ] || printf '"apn":"%s",' "$apn"
    printf '"pdp-type":"%s","apn-disabled":%s}\n' "$(cat "$state/profile.pdp")" "$off"
}

check_start_options() {
    for option in --apn --profile --auth-type --username --password; do
        if [ "${1:-}" = "$option" ]; then
            [ "$#" -ge 2 ] || unsupported "missing value for $option"
            case $2 in --*) unsupported "expected a value for $option" ;; esac
            shift 2
        fi
    done
    auto=0
    [ "${1:-}" != --autoconnect ] || { auto=1; shift; }
    [ "$#" = 0 ] || unsupported 'start arguments'
}

start_call() {
    check_start_options "$@"
    [ -n "$family" ] || unsupported 'start without a selected family'
    [ -f "$state/profile.pdp" ] || unsupported 'start without a stored profile'
    grep -qxF "$(cat "$state/profile.pdp") $family" "$state/scenario" || qmi_error 'Call failed'
    # need-apn: a network that grants calls only with this APN in profile 1
    [ ! -f "$state/need-apn" ] || [ "$(cat "$state/profile.apn")" = "$(cat "$state/need-apn")" ] ||
        qmi_error 'Call failed'
    [ ! -e "$calls/$family" ] || qmi_error 'No effect'
    case $family in ipv4) handle=-12345678 ;; ipv6) handle=12345679 ;; esac
    printf '%s %s %s\n' "$cid" "$handle" "$auto" >"$calls/$family"
    printf '%s\n' "$handle"
}

call_owned() {
    [ -n "$family" ] && [ -s "$calls/$family" ] &&
        read -r owner handle _ <"$calls/$family" && [ "$owner" = "$cid" ]
}

stop_wildcard() {
    # With no CID the initial sweep is family-wide. The CID form is local to its client, unless the
    # state file wide-wildcard says the modem's wildcard also reaches the other client's call
    # (unmeasured on the MF289F, SPEC Unverified).
    if [ -z "$cid" ]; then
        rm -f "$calls/$family"
    elif [ -e "$state/wide-wildcard" ]; then
        rm -f "$calls"/*
    elif call_owned; then
        rm -f "$calls/$family"
    fi
}

current_settings() {
    call_owned || qmi_error 'Out of call'
    # a test can put its own report (incomplete, invalid) into the state directory, and a report for
    # every read after the first (settings-<family>.next.json: the modem answering differently the
    # second time, R73j)
    reads=$(cat "$state/settings-$family.reads" 2>/dev/null || echo 0)
    echo $((reads + 1)) >"$state/settings-$family.reads"
    if [ "$reads" -ge 1 ] && [ -f "$state/settings-$family.next.json" ]; then
        cat "$state/settings-$family.next.json"
    elif [ -f "$state/settings-$family.json" ]; then
        cat "$state/settings-$family.json"
    else
        cat "/fw/tests/qmi/settings/$family.json"
    fi
}

pin_status() {
    pin=disabled
    if [ -f "$state/pin" ]; then
        pin=not_verified
        [ ! -e "$state/pin-verified" ] || pin=verified
    fi
    printf '{"pin1_status":"%s","pin1_verify_tries":3}\n' "$pin"
}

sim_command() {
    case "$1:$#" in
        --get-pin-status:1) pin_status ;;
        --uim-get-sim-state:1) echo '{"card_application_state":"ready"}' ;;
        --verify-pin1:2 | --uim-verify-pin1:2)
            [ -f "$state/pin" ] && [ "$2" = "$(cat "$state/pin")" ] || qmi_error 'Incorrect PIN'
            : >"$state/pin-verified"
            ;;
        --get-iccid:1) printf '"%s"\n' "$(cat "$state/iccid")" ;;
        *) unsupported 'SIM command' ;;
    esac
}

modem_command() {
    case "$1:$#" in
        --set-device-operating-mode:2) [ "$2" = online ] || unsupported 'operating mode' ;;
        --set-data-format:2 | --wda-set-data-format:2)
            [ "$2" = 802.3 ] || unsupported 'data format'
            ;;
        --wda-get-data-format:1)
            printf '{"link-layer-protocol":"%s"}\n' "$(cat "$state/data-format")"
            ;;
        # releases every client of the device, calls stay
        --sync:1) rm -f "$clients"/* ;;
        *) unsupported 'modem command' ;;
    esac
}

network_command() {
    case "$1:$#" in
        --network-register:1) [ -e "$state/no-register" ] || : >"$state/registered" ;;
        --get-serving-system:1)
            registration=not_registered
            [ ! -e "$state/registered" ] || registration=registered
            printf '{"registration":"%s"}\n' "$registration"
            ;;
        --set-network-modes:2)
            [ "$2" = lte ] || unsupported 'network mode'
            printf '%s\n' "$2" >"$state/modes"
            ;;
        *) unsupported 'network command' ;;
    esac
}

stop_handle() {
    case ${1#-} in '' | *[!0-9]*) unsupported 'stop handle' ;; esac
    call_owned && [ "$handle" = "$1" ] || qmi_error 'No effect'
    rm "$calls/$family"
}

client_command() {
    case "$1:$#" in
        --start-network:*) shift; start_call "$@" ;;
        --get-data-status:1)
            if call_owned; then echo '"connected"'; else echo '"disconnected"'; fi
            ;;
        --get-current-settings:1) current_settings ;;
        --release-client-id:2)
            [ "$2" = wds ] || unsupported 'release service'
            rm -f "$clients/$cid"
            ;;
        --stop-network:3)
            [ "$2" = 0xffffffff ] && [ "$3" = --autoconnect ] || unsupported 'stop arguments'
            stop_wildcard
            ;;
        --stop-network:2) stop_handle "$2" ;;
        *) unsupported 'client command' ;;
    esac
}

with_client() {
    if [ "$1" = --set-ip-family ]; then
        case ${2:-} in ipv4 | ipv6) family=$2 ;; *) unsupported 'IP family' ;; esac
        [ "$#" = 2 ] || { [ "$#" = 3 ] && [ "$3" = --get-data-status ]; } ||
            unsupported 'family arguments'
        printf '%s\n' "$family" >"$clients/$cid"
        shift 2
        [ "$#" != 0 ] || return 0
    fi
    client_command "$@"
}

[ "${1:-}" != -s ] || shift
[ "$#" -ge 5 ] && [ "$1" = -d ] && [ "$2" = /dev/cdc-wdm0 ] && [ "$3" = -t ] ||
    unsupported 'expected -d /dev/cdc-wdm0 -t TIMEOUT'
case $4 in '' | *[!0-9]*) unsupported 'timeout' ;; esac
shift 4
inject -t "$(printf '%s' "$joined" | sed -n 's/.* -t \([0-9][0-9]*\).*/\1/p')" "$@"
cid=
case "$1:$#" in
    --get-client-id:2)
        [ "$2" = wds ] || unsupported 'client service'
        allocate_client
        ;;
    --modify-profile:6) shift; profile_write "$@" ;;
    --get-profile-settings:2) profile_read "$2" ;;
    --stop-network:3)
        [ "$2" = 0xffffffff ] && [ "$3" = --autoconnect ] || unsupported 'stop arguments'
        family=ipv4
        stop_wildcard
        ;;
    --set-ip-family:5)
        [ "$2" = ipv6 ] && [ "$3" = --stop-network ] && [ "$4" = 0xffffffff ] &&
            [ "$5" = --autoconnect ] || unsupported 'family sweep arguments'
        family=ipv6
        stop_wildcard
        ;;
    --set-client-id:*)
        [ "$#" -ge 3 ] || unsupported 'missing client or command'
        cid=${2#wds,}
        [ "$2" = "wds,$cid" ] || unsupported 'client service'
        case $cid in '' | *[!0-9]*) unsupported 'client ID' ;; esac
        # a released or never allocated client is an error of the modem
        [ -f "$clients/$cid" ] || qmi_error 'Invalid client ID'
        family=$(cat "$clients/$cid")
        shift 2
        with_client "$@"
        ;;
    --get-pin-status:* | --uim-get-sim-state:* | --verify-pin1:* | --uim-verify-pin1:* | --get-iccid:*)
        sim_command "$@"
        ;;
    --network-register:* | --get-serving-system:* | --set-network-modes:*)
        network_command "$@"
        ;;
    *) modem_command "$@" ;;
esac
