#!/bin/sh
# Test stand-in for uclient-fetch: a fake Telegram Bot API (getUpdates, sendMessage, editMessageText,
# answerCallbackQuery, getMe) with its state in $LW_TEST/tg, and a fake healthchecks.io ping for every
# address that is not the Bot API. Knobs:
#   tg/net             up (default), down (fails at once, exit 4) or hang (never answers)
#   tg/token           the token the fake bot accepts; another one fails with exit 8 (HTTP 401)
#   tg/username        the bot's username that getMe gives (default TestBot)
#   tg/updates/N.json  pending updates, update_id N (tests/notify/helpers.inc tg_push writes them)
#   tg/reject400       sendMessage answered like Telegram does for a bad request: "HTTP error 400"
#                      on stderr, exit 8, no body. One rule per line: "byte HH" rejects a text with
#                      the percent-encoded byte %HH, "nonascii" a text with any byte above 7F,
#                      "utf8" a text that is not valid UTF-8, "has STRING" a text that contains
#                      STRING, "all" every text. Each rejection adds a line to tg/rejected; with
#                      tg/down_after_reject present it also sets tg/net to down (the network drops
#                      between a message and its retry).
#                      Two more rules, for HTML (R37g): "html" rejects a sendMessage or editMessageText
#                      with parse_mode=HTML, "edit" every editMessageText.
#   tg/status          an HTTP status (e.g. 500, 429) every call answers with: "HTTP error N" on
#                      stderr, exit 8
# parse_mode: the field is recorded per message in tg/sent/N.mode and per edit in tg/edits/K.mode
# (empty for plain text). With parse_mode=HTML the text must be markup Telegram takes: only the tags
# b, i, u, s, code, pre, blockquote, properly nested and closed, a "<", ">" or "&" that is not part of
# a tag or of one of the entities &amp; &lt; &gt; &quot; is a 400, as is an empty text. The check is
# written here apart from the code under test, so every test of the bot also tests its markup.
# Like the real one, it prints "Downloading '<URL with the token>'" and "Connecting to ..." on
# stderr unless called with -q, so a test sees whether the caller keeps that stderr out of logs.
#   hc/mode           for addresses outside the Bot API (the healthchecks.io ping): up (default),
#                     down (exit 4), hang (never answers) or an HTTP status such as 500 ("HTTP error
#                     500" on stderr, exit 8); every call is a line "quiet|loud <url>" in hc/calls
# sendPhoto (R51) is a multipart/form-data body, parsed here from the bytes, not from the code under
# test: the client must have sent exactly one Content-Type header, multipart/form-data with a boundary,
# every line end in the body must be CRLF, the fields chat_id and photo (with a file name) must be
# there, parse_mode HTML needs a caption Telegram takes (valid markup, at most 1024 characters after
# the markup and entities are read). Records per message, next to sendMessage's: tg/sent/N.chat,
# N.caption (also as N.text and N.shown, so the helpers that count messages see it), N.mode,
# N.photo (the bytes), N.photoname, N.phototype, N.ctype (the Content-Type header as sent).
# tg/reject_photo: when the file exists and is not empty, every sendPhoto is answered with HTTP 400.
# tg/photo_fail: only sendPhoto fails, after the update that asked for it was read: "net" is a
# connection error (exit 4), a number such as 500 or 429 that HTTP status (exit 8).
# Buttons: tg_tap (helpers.inc) writes callback_query updates. sendMessage with a reply_markup keeps
# it in tg/sent/N.markup (anything but a valid inline_keyboard, force_reply or reply keyboard is a 400). editMessageText with an
# unknown message_id or the text the message already shows is a 400 like Telegram's; it records
# tg/edits/K.{msgid,text,markup}, shows the new text in tg/sent/N.shown and replaces the buttons
# with its reply_markup; without a reply_markup it leaves them as they are (the conservative model:
# the code must remove buttons explicitly). answerCallbackQuery goes to tg/answers/N (id, text,
# alert).
# Records: tg/allowed (the allowed_updates of the last getUpdates), tg/polls (the long-poll time of every getUpdates, one per line), tg/calls (one method per
# call), tg/sent/N.chat, tg/sent/N.text and tg/sent/N.markup per sendMessage.
# getUpdates follows the Bot API: offset > 0 confirms (deletes) older updates, offset -1 keeps
# only the newest; an empty answer waits at most 1 s instead of the long-poll time.
T=${LW_TEST:-/lwtest}
G=$T/tg
mkdir -p "$G/updates" "$G/sent"
body=
url=
quiet=
ctypes=
while [ $# -gt 0 ]; do
    case $1 in
        -q) quiet=1 && shift ;;
        --header=Content-Type:* | --header=content-type:*)
            ctypes="$ctypes${1#--header=}
"
            shift
            ;;
        -T | -O | -U | -P) shift 2 ;;
        --post-file=*) body=${1#--post-file=} && shift ;;
        -*) shift ;;
        *) url=$1 && shift ;;
    esac
done
case $url in
    */bot*/*) ;;
    *)
        # not the Bot API: the healthchecks.io ping
        mkdir -p "$T/hc"
        if [ -n "$quiet" ]; then echo "quiet $url" >>"$T/hc/calls"; else echo "loud $url" >>"$T/hc/calls"; fi
        [ -n "$quiet" ] || printf "Downloading '%s'\n" "$url" >&2
        case $(cat "$T/hc/mode" 2>/dev/null) in
            down) echo "Connection error: Failed to resolve host" >&2 && exit 4 ;;
            hang) sleep 3600 && exit 0 ;;
            [0-9][0-9][0-9]) echo "HTTP error $(cat "$T/hc/mode")" >&2 && exit 8 ;;
        esac
        echo OK
        exit 0
        ;;
esac
method=${url##*/}
# the mode of the request body, as ls prints it: the body can hold SMS texts or the Wi-Fi password
[ -z "$body" ] || ls -ld "$body" | cut -c1-10 >>"$G/body-modes"
token=${url%/*}
token=${token##*/bot}
echo "$method" >>"$G/calls"
[ -n "$quiet" ] || printf "Downloading '%s'\nConnecting to api.telegram.org\n" "$url" >&2

case $(cat "$G/net" 2>/dev/null) in
    down) echo "Connection error: Failed to resolve host" >&2 && exit 4 ;;
    hang) sleep 3600 && exit 0 ;;
esac
[ "$token" = "$(cat "$G/token" 2>/dev/null)" ] || { echo "HTTP error 401" >&2; exit 8; }

# param NAME: one form field of the body, decoded
param() {
    v=$(tr '&' '\n' <"$body" | sed -n "s/^$1=//p")
    printf '%b' "$(printf '%s' "$v" | sed 's/+/ /g; s/%/\\x/g')"
}

# utf8_valid: stdin (hex bytes, no separators) is valid UTF-8 (RFC 3629), by a regular expression
# over the hex digits, so it shares no logic with the code under test
utf8_valid() {
    awk 'BEGIN { c = "[89AB][0-9A-F]"
        r = "^([0-7][0-9A-F]|(C[2-9A-F]|D[0-9A-F])" c "|E0[AB][0-9A-F]" c
        r = r "|(E[1-9A-CEF])" c c "|ED[89][0-9A-F]" c "|F0[9AB][0-9A-F]" c c
        r = r "|F[123]" c c c "|F48[0-9A-F]" c c ")*$" }
        { ok = ($0 ~ r) } END { exit !ok }'
}

# html_valid: stdin is HTML as Telegram's parse_mode=HTML takes it (see the header)
html_valid() {
    awk '
        { buf = buf (NR > 1 ? "\n" : "") $0 }
        END {
            if (buf == "") exit 1
            n = 0
            i = 1
            len = length(buf)
            while (i <= len) {
                c = substr(buf, i, 1)
                if (c == "<") {
                    j = index(substr(buf, i), ">")
                    if (j == 0) exit 1
                    tag = substr(buf, i + 1, j - 2)
                    i += j
                    closing = (substr(tag, 1, 1) == "/")
                    if (closing) tag = substr(tag, 2)
                    if (tag !~ /^(b|i|u|s|code|pre|blockquote)$/) exit 1
                    if (closing) {
                        if (n == 0 || st[n] != tag) exit 1
                        n--
                    } else st[++n] = tag
                    continue
                }
                if (c == ">") exit 1
                if (c == "&") {
                    rest = substr(buf, i, 6)
                    if (rest ~ /^&(amp|lt|gt);/) { i += (substr(rest, 2, 1) == "a" ? 5 : 4); continue }
                    if (rest ~ /^&quot;/) { i += 6; continue }
                    exit 1
                }
                i++
            }
            exit (n != 0)
        }'
}

# rejected METHOD: the text in $body breaks a rule of tg/reject400 (only the rules "html" and "edit"
# look at editMessageText)
rejected() {
    [ -f "$G/reject400" ] || return 1
    enc=$(tr '&' '\n' <"$body" | sed -n 's/^text=//p')
    while read -r rule arg; do
        case $rule in
            html) [ "$(param parse_mode)" != HTML ] || return 0 ;;
            edit) [ "$1" != editMessageText ] || return 0 ;;
        esac
        [ "$1" = sendMessage ] || continue
        case $rule in
            all) return 0 ;;
            byte) ! printf '%s' "$enc" | grep -qi "%$arg" || return 0 ;;
            nonascii) ! printf '%s' "$enc" | grep -qi '%[89A-F][0-9A-F]' || return 0 ;;
            utf8) param text | hexdump -v -e '/1 "%02X"' | utf8_valid || return 0 ;;
            has) ! param text | grep -qF -- "$arg" || return 0 ;;
        esac
    done <"$G/reject400"
    return 1
}

# markup_ok: the reply_markup field, when there is one, is an inline keyboard (a JSON object with
# the list inline_keyboard), a force_reply (true, with an input_field_placeholder of 1 to 64
# characters when present) or a reply keyboard (the list keyboard, whose rows hold buttons with a
# text; is_persistent and resize_keyboard must be booleans when present), as Telegram demands
markup_ok() {
    m=$(param reply_markup)
    [ -z "$m" ] && return 0
    [ -z "$(printf '%s\n' "$m" | jsonfilter -e '@.inline_keyboard' 2>/dev/null)" ] || return 0
    if [ "$(printf '%s\n' "$m" | jsonfilter -e '@.force_reply' 2>/dev/null)" = true ]; then
        p=$(printf '%s\n' "$m" | jsonfilter -e '@.input_field_placeholder' 2>/dev/null)
        [ "${#p}" -le 64 ] && return 0
        return 1
    fi
    [ -n "$(printf '%s\n' "$m" | jsonfilter -e '@.keyboard[0][0].text' 2>/dev/null)" ] || return 1
    for k in is_persistent resize_keyboard; do
        v=$(printf '%s\n' "$m" | jsonfilter -e "@.$k" 2>/dev/null)
        case $v in '' | true | false) ;; *) return 1 ;; esac
    done
}

# multipart BOUNDARY: the parts of the multipart body in $body, as lines "name, filename, type, byte
# offset, length" separated by the character 0x1F, on stdout; exit 1 when the body is not well formed (no CRLF where the format
# demands it, a text before the first boundary, no closing boundary or something after it). Works on
# the hex digits of the file, so it is binary-safe and shares no logic with the code under test.
multipart() {
    bhex=$(printf '%s' "--$1" | hexdump -v -e '/1 "%02X"')
    hexdump -v -e '/1 "%02X"' "$body" | awk -v D="$bhex" '
        BEGIN { for (i = 0; i < 256; i++) v[sprintf("%02X", i)] = i }
        { H = H $0 }
        function ascii(h,    o, i) {
            for (i = 1; i < length(h); i += 2) o = o sprintf("%c", v[substr(h, i, 2)])
            return o
        }
        END {
            dl = length(D); p = 1; n = 0
            while ((i = index(substr(H, p), D)) > 0) {
                q = p + i - 1
                if ((q - 1) % 2 == 0) { st[++n] = q; p = q + dl } else p = q + 1
            }
            if (n < 2 || st[1] != 1) exit 1
            if (substr(H, st[n] + dl) != "2D2D0D0A") exit 1
            for (k = 1; k < n; k++) {
                seg = substr(H, st[k] + dl, st[k + 1] - st[k] - dl)
                if (substr(seg, 1, 4) != "0D0A" || substr(seg, length(seg) - 3) != "0D0A") exit 1
                seg = substr(seg, 5, length(seg) - 8)
                he = index(seg, "0D0A0D0A")
                if (he == 0 || (he - 1) % 2 != 0) exit 1
                hdr = ascii(substr(seg, 1, he - 1))
                name = ""; fn = ""; ty = ""
                if (match(hdr, /name="[^"]*"/)) name = substr(hdr, RSTART + 6, RLENGTH - 7)
                if (match(hdr, /filename="[^"]*"/)) fn = substr(hdr, RSTART + 10, RLENGTH - 11)
                if (match(hdr, /Content-Type: [^\r]*/)) ty = substr(hdr, RSTART + 14, RLENGTH - 14)
                off = (st[k] + dl - 1 + 4 + he - 1 + 8) / 2
                len = (length(seg) - he - 7) / 2
                printf "%s\037%s\037%s\037%d\037%d\n", name, fn, ty, off, len
            }
        }'
}

# caption_chars: the number of characters Telegram counts in the caption on stdin (no trailing new
# line): the markup is not counted and an entity is one character; UTF-8 continuation bytes are not.
caption_chars() {
    sed 's/<[^>]*>//g; s/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g' | hexdump -v -e '/1 "%02X\n"' |
        awk '$1 !~ /^[89AB]/ { n++ } END { print n - 1 }'
}

# photo_request: the sendPhoto in $body: parses it, checks it like Telegram would, records it as
# message N; exit 1 for a request Telegram answers with HTTP 400.
photo_request() {
    [ "$(printf '%s' "$ctypes" | grep -c .)" = 1 ] || return 1
    ctype=$(printf '%s' "$ctypes" | sed 's/^[^:]*: *//')
    case $ctype in
        'multipart/form-data; boundary='*) ;;
        *) return 1 ;;
    esac
    boundary=${ctype#*boundary=}
    d=$(mktemp -d "$G/mp.XXXXXX")
    multipart "$boundary" >"$d/parts" || { rm -r -f "$d"; return 1; }
    us=$(printf '\037')
    while IFS=$us read -r name fn ty off len; do
        [ -n "$name" ] || continue
        tail -c +$((off + 1)) "$body" | head -c "$len" >"$d/$name.val"
        printf '%s' "$fn" >"$d/$name.fn"
        printf '%s' "$ty" >"$d/$name.ty"
    done <"$d/parts"
    if [ ! -s "$d/chat_id.val" ] || [ ! -f "$d/photo.val" ] || [ -z "$(cat "$d/photo.fn")" ]; then
        rm -r -f "$d"
        return 1
    fi
    mode=$(cat "$d/parse_mode.val" 2>/dev/null)
    cap=$(cat "$d/caption.val" 2>/dev/null; printf x)
    cap=${cap%x}
    if [ "$mode" = HTML ] && [ -n "$cap" ] && ! printf '%s' "$cap" | html_valid; then
        rm -r -f "$d"
        return 1
    fi
    if [ "$(printf '%s' "$cap" | caption_chars)" -gt 1024 ]; then
        rm -r -f "$d"
        return 1
    fi
    n=$(($(find "$G/sent" -name '*.text' | wc -l) + 1))
    cp "$d/chat_id.val" "$G/sent/$n.chat"
    printf '%s' "$cap" >"$G/sent/$n.caption"
    printf '%s' "$cap" >"$G/sent/$n.text"
    printf '%s' "$cap" >"$G/sent/$n.shown"
    : >"$G/sent/$n.markup"
    printf '%s' "$mode" >"$G/sent/$n.mode"
    cp "$d/photo.val" "$G/sent/$n.photo"
    cp "$d/photo.fn" "$G/sent/$n.photoname"
    cp "$d/photo.ty" "$G/sent/$n.phototype"
    printf '%s' "$ctype" >"$G/sent/$n.ctype"
    rm -r -f "$d"
}

ids() { for f in "$G"/updates/*.json; do [ -f "$f" ] && basename "$f" .json; done | sort -n; }

if [ -n "$(cat "$G/status" 2>/dev/null)" ]; then
    echo "HTTP error $(cat "$G/status")" >&2
    exit 8
fi

case $method in
    getUpdates)
        offset=$(param offset)
        param timeout >>"$G/polls"
        echo >>"$G/polls"
        if [ "$offset" = -1 ]; then
            for i in $(ids | sed '$d'); do rm -f "$G/updates/$i.json"; done
        elif [ "${offset:-0}" -gt 0 ]; then
            for i in $(ids); do [ "$i" -ge "$offset" ] || rm -f "$G/updates/$i.json"; done
        fi
        [ -n "$(ids)" ] || [ "$(param timeout)" = 0 ] || sleep 1
        # Telegram sends only the kinds of update the call allows (allowed_updates)
        allowed=$(param allowed_updates)
        [ -z "$allowed" ] || echo "$allowed" >"$G/allowed"
        printf '{"ok":true,"result":['
        sep=
        for i in $(ids); do
            if [ -n "$allowed" ] && grep -q '"callback_query"' "$G/updates/$i.json"; then
                case $allowed in *callback_query*) ;; *) continue ;; esac
            fi
            printf '%s%s' "$sep" "$(cat "$G/updates/$i.json")"
            sep=,
        done
        printf ']}\n'
        ;;
    sendMessage)
        if rejected sendMessage; then
            echo x >>"$G/rejected"
            ! [ -f "$G/down_after_reject" ] || echo down >"$G/net"
            echo "HTTP error 400" >&2
            exit 8
        fi
        markup_ok || { echo "HTTP error 400" >&2; exit 8; }
        mode=$(param parse_mode)
        # a text that Telegram would refuse is a 400 and is counted like a rule rejection
        if [ "$mode" = HTML ] && ! param text | html_valid; then
            echo x >>"$G/rejected"
            echo "HTTP error 400" >&2
            exit 8
        fi
        n=$(($(find "$G/sent" -name '*.text' | wc -l) + 1))
        param chat_id >"$G/sent/$n.chat"
        param text >"$G/sent/$n.text"
        param text >"$G/sent/$n.shown"
        param reply_markup >"$G/sent/$n.markup"
        printf '%s' "$mode" >"$G/sent/$n.mode"
        printf '{"ok":true,"result":{"message_id":%s}}\n' "$n"
        ;;
    sendPhoto)
        case $(cat "$G/photo_fail" 2>/dev/null) in
            '') ;;
            net) echo "Connection error: Failed to resolve host" >&2 && exit 4 ;;
            *) echo "HTTP error $(cat "$G/photo_fail")" >&2 && exit 8 ;;
        esac
        if [ -s "$G/reject_photo" ] || ! photo_request; then
            echo x >>"$G/rejected"
            ! [ -f "$G/down_after_reject" ] || echo down >"$G/net"
            echo "HTTP error 400" >&2
            exit 8
        fi
        printf '{"ok":true,"result":{"message_id":%s}}\n' "$n"
        ;;
    editMessageText)
        id=$(param message_id)
        if rejected editMessageText; then
            echo x >>"$G/rejected"
            echo "HTTP error 400" >&2
            exit 8
        fi
        mode=$(param parse_mode)
        if [ "$mode" = HTML ] && ! param text | html_valid; then
            echo x >>"$G/rejected"
            echo "HTTP error 400" >&2
            exit 8
        fi
        markup_ok || { echo "HTTP error 400" >&2; exit 8; }
        [ -f "$G/sent/$id.text" ] && [ "$(param chat_id)" = "$(cat "$G/sent/$id.chat")" ] ||
            { echo "HTTP error 400" >&2; exit 8; }
        # Telegram refuses an edit that changes neither the text nor the buttons
        if [ "$(param text)" = "$(cat "$G/sent/$id.shown")" ] &&
            { [ -z "$(param reply_markup)" ] || [ "$(param reply_markup)" = "$(cat "$G/sent/$id.markup")" ]; }; then
            echo "HTTP error 400" >&2
            exit 8
        fi
        mkdir -p "$G/edits"
        k=$(($(find "$G/edits" -name '*.msgid' | wc -l) + 1))
        echo "$id" >"$G/edits/$k.msgid"
        param text >"$G/edits/$k.text"
        param reply_markup >"$G/edits/$k.markup"
        printf '%s' "$mode" >"$G/edits/$k.mode"
        param text >"$G/sent/$id.shown"
        [ -z "$(param reply_markup)" ] || param reply_markup >"$G/sent/$id.markup"
        printf '{"ok":true,"result":{"message_id":%s}}\n' "$id"
        ;;
    getMe)
        printf '{"ok":true,"result":{"id":7,"is_bot":true,"first_name":"Router","username":"%s"}}\n' \
            "$(cat "$G/username" 2>/dev/null || echo TestBot)"
        ;;
    answerCallbackQuery)
        mkdir -p "$G/answers"
        k=$(($(find "$G/answers" -name '*.id' | wc -l) + 1))
        param callback_query_id >"$G/answers/$k.id"
        param text >"$G/answers/$k.text"
        param show_alert >"$G/answers/$k.alert"
        printf '{"ok":true,"result":true}\n'
        ;;
    *) echo "HTTP error 404" >&2 && exit 8 ;;
esac
