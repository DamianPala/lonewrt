#!/bin/sh
# Data session watcher (SPEC R49 to R49i, D80, D177). When the mobile network detaches the modem and the
# modem attaches again by itself, the call of netifd stays dead: wwan0 keeps its old address and
# netifd shows wwan as up, but the modem is "Out of call". This script looks every 5 s, and when the
# session is lost with the modem registered it starts the call again on netifd's own QMI client and
# renews the DHCP lease, about 2 s in all; a full `ifup wwan` takes 14 to 15 s (D82; 40 to 46 s while
# qmi.sh still scanned the network, which the image no longer does, R12d). After 20 s without
# success it runs `ifup wwan` once; watchcat (R14) and wwan-recover (R16) stay behind it.
#
#   lw-linkwatch run    the procd service: one pass every LW_LINKWATCH_PERIOD seconds (5)
#   lw-linkwatch once   one pass without waiting (tests, manual check)
#
# This is the only script of the image that runs uqmi (R12c, D80). uqmi has no event mode and a
# second reader of /dev/cdc-wdm0 would steal answers, so it polls; it makes no call unless netifd
# shows wwan as up, because qmi.sh uses uqmi while it sets the interface up (R49a). Every call has
# -t and a timeout around it: uqmi is known to hang. State lives in RAM under $LK_RUN, written only
# when something changes, so a healthy pass writes nothing to syslog or flash (R49f).
#
# The session decides, not network.wwan.pdptype (D177): the watcher works on the native IPv4 call
# in netifd's data (cid_4, pdh_4), on that client alone, and checks before every modem call, signal
# and escalation that netifd still shows the same session (R49h). An IPv6 call next to it (cid_6)
# is never stopped or restarted, and `ifup wwan` never goes out for it unless a family check of
# this session says IPv6 is silent (R49d, D196, D200). Its state is only read, while IPv4 is
# healthy, so that the LAN stops advertising an IPv6 call that the modem lost without a netifd
# event (R74f, R49i): a confirmed loss goes into a flag of lan6.sh and the LAN is reloaded.

# shellcheck source=src/files/usr/lib/lw/common.sh
. /usr/lib/lw/common.sh

LK_TAG=lw-linkwatch
LK_IFACE=wwan
# R49d, R49e: the markers hold back an ifup and the restores, so they live in root's run directory,
# not the public /tmp; a directory that is not root's, or a link, gets nothing and is not believed
LK_RUN=${LW_LINKWATCH_RUN:-/var/run/lw-linkwatch}
# the command that signals udhcpc; tests put a recording stand-in here
LK_KILL=${LW_LINKWATCH_KILL:-kill}
# Seconds; tests shorten them through the environment
LK_PERIOD=${LW_LINKWATCH_PERIOD:-5}
LK_STEP=${LW_LINKWATCH_STEP:-2}
LK_SETTLE=${LW_LINKWATCH_SETTLE:-1}
LK_HEARTBEAT=${LW_LINKWATCH_HEARTBEAT:-300}
LK_AT_LIMIT=${LW_LINKWATCH_AT_LIMIT:-5}
# timeout around each uqmi call; empty = the call's own -t plus 2 s
LK_UQMI_LIMIT=${LW_LINKWATCH_UQMI_LIMIT:-}
# R49d: the latest family check of the IPv6 call (lk_v6_silent); tests put theirs here
LK_V6_RESULT=${LW_LINKWATCH_V6_RESULT:-$LW_FAMILY_DIR/ipv6}
# R74f: odhcpd's init script, which reloads the LAN's IPv6 from the session and the flag; tests put theirs here
LK_LAN6=${LW_LINKWATCH_LAN6:-/etc/init.d/odhcpd}
# R74f: the mark of lan6.sh that a change of the LAN did not reach odhcpd (a builtin test per pass),
# and the seconds between two attempts to finish it
LK_LAN6_PENDING=${LW_LINKWATCH_LAN6_PENDING:-/var/run/lw-odhcpd/pending}
LK_REPLAY=${LW_LINKWATCH_REPLAY:-30}
# R49d: seconds from the first sight of the loss to `ifup wwan`
LK_GIVE_UP=20
# R49c: a renew that did not bring the address is repeated after this many seconds
LK_KICK_EVERY=6
# R49e: this many restores within the window mean the restore does not hold; then a pause
LK_BRAKE_COUNT=3
LK_BRAKE_WINDOW=600
LK_BRAKE_PAUSE=600
# R49c: looks at the device address after the release before USR1 is sent (25 are about 0.2 s)
LK_RELEASE_LOOKS=25
# a call this slow (centiseconds) or one that fails counts in the debug heartbeat (R49g)
LK_SLOW_CS=200

LK_PASSES=0
LK_BAD=0
LK_SLOWEST=0
LK_NAP=
LK_NOTED=
LK_OUT=
# R49h: why an incident ended without being ours any more (2 down, 3 another session), the session
# it began in, and whether another call (IPv6) may exist next to its IPv4 call
LK_ENDED=
LK_SID0=
LK_BIRTH0=
LK_SIB=
LK_STATIC=
# R74f: when the last attempt to finish an unfinished reload of the LAN was made (centiseconds), and
# the IPv6 call (client/handle) of the pass
LK_REPLAY_AT=
LK_V6ID0=

# lk_cs: uptime in centiseconds in LK_CS, with shell builtins only (no fork per reading); the clock
# is the uptime file of common.sh because the router has no RTC (D9) and tests move that file.
lk_cs() {
    read -r _lk_u _ <"$LW_UPTIME_FILE"
    _lk_f=${_lk_u#*.}00
    _lk_f=${_lk_f%"${_lk_f#??}"}
    _lk_f=${_lk_f#0}
    LK_CS=$((${_lk_u%%.*} * 100 + ${_lk_f:-0}))
}

# lk_elapsed: whole seconds since the loss was first seen, in LK_EL.
lk_elapsed() {
    lk_cs
    LK_EL=$(((LK_CS - LK_T0) / 100))
}

lk_nap() {
    sleep "$1" &
    LK_NAP=$!
    wait "$LK_NAP"
    LK_NAP=
}

lk_dbg() { lw_debug "$LK_TAG" "$*"; }

# lk_idbg MESSAGE: a step of an incident with its time since the loss was seen.
lk_idbg() {
    lw_is_debug || return 0
    lk_elapsed
    lw_debug "$LK_TAG" "+${LK_EL}s $*"
}

# lk_ascii TEXT: TEXT as one printable-ASCII line of at most 300 bytes (R29b): the modem and the
# operator can send any byte, and a log line must not carry them
lk_ascii() {
    printf '%s' "$1" | tr '\n' '|' | LC_ALL=C tr -c '\40-\176' '?' | cut -c1-300
}

# lk_uqmi LABEL MS ARGS...: one uqmi call; the answer in LK_OUT (empty after a timeout), the exit
# code of uqmi as return value. LABEL names the call in the debug log: the arguments are not logged,
# they may hold the APN login.
lk_uqmi() {
    _lk_label=$1
    _lk_ms=$2
    shift 2
    lk_cs
    _lk_c0=$LK_CS
    _lk_rc=0
    LK_OUT=$(timeout -k 1 "${LK_UQMI_LIMIT:-$((_lk_ms / 1000 + 2))}" \
        uqmi -s -d "$LK_DEV" -t "$_lk_ms" "$@" 2>/dev/null </dev/null) || _lk_rc=$?
    case $_lk_rc in 124 | 137) LK_OUT= ;; esac
    lk_cs
    _lk_dt=$((LK_CS - _lk_c0))
    [ "$_lk_dt" -le "$LK_SLOWEST" ] || LK_SLOWEST=$_lk_dt
    if [ "$_lk_rc" != 0 ] || [ -z "$LK_OUT" ] || [ "$_lk_dt" -ge "$LK_SLOW_CS" ]; then
        LK_BAD=$((LK_BAD + 1))
        lk_dbg "uqmi $_lk_label: answer '$(lk_ascii "$LK_OUT")', exit $_lk_rc, $((_lk_dt * 10)) ms"
    fi
    return "$_lk_rc"
}

# lk_netifd: the status of wwan in LK_UP, LK_L3, LK_UPT (seconds up), LK_CID, LK_PDH (the IPv4 call
# of netifd's session, the client and the handle the handler started) and LK_CID6, LK_PDH6 (the
# IPv6 call, R73e); fails unless netifd shows the interface up.
lk_netifd() {
    LK_UP='' LK_L3='' LK_UPT='' LK_CID='' LK_PDH='' LK_CID6='' LK_PDH6=''
    _lk_j=$(timeout 5 ifstatus "$LK_IFACE" 2>/dev/null) || return 1
    eval "$(printf '%s\n' "$_lk_j" | jsonfilter -e 'LK_UP=@.up' -e 'LK_L3=@.l3_device' \
        -e 'LK_UPT=@.uptime' -e 'LK_CID=@.data.cid_4' -e 'LK_PDH=@.data.pdh_4' \
        -e 'LK_CID6=@.data.cid_6' -e 'LK_PDH6=@.data.pdh_6' 2>/dev/null)"
    # jsonfilter writes a JSON true as 1
    [ "$LK_UP" = 1 ] || return 1
    lk_session
}

# lk_session: LK_SID, the IPv4 call as netifd published it, and LK_BIRTH, the second on the clock of
# lk_cs at which this start of the interface came up (empty when netifd gives no uptime). The same
# client and handle with another birth are another start (R49h): a start can get the numbers again.
lk_session() {
    LK_SID=$LK_CID/$LK_PDH
    LK_BIRTH=
    case $LK_UPT in '' | *[!0-9]*) return 0 ;; esac
    lk_cs
    LK_BIRTH=$((LK_CS / 100 - LK_UPT))
}

# lk_native4: R49a, netifd's data holds a native IPv4 call, a client and a numeric (signed) handle.
lk_native4() {
    case $LK_CID in '' | *[!0-9]*) return 1 ;; esac
    case ${LK_PDH#-} in '' | *[!0-9]*) return 1 ;; esac
}

# lk_same SID BIRTH: that session is the one netifd shows now; the births may differ by the rounding
# of two readings and by how long a status read took (up to its 5 s limit), and are not compared
# when one is unknown. A new start of the interface takes about 14 s (D82), well apart from that.
lk_same() {
    [ "$1" = "$LK_SID" ] || return 1
    case $2 in
        '' | -) return 0 ;;
        *[!0-9]*) return 1 ;;
    esac
    [ -n "$LK_BIRTH" ] || return 0
    _lk_d=$(($2 - LK_BIRTH))
    [ "$_lk_d" -ge -6 ] && [ "$_lk_d" -le 6 ]
}

# lk_own: R49h. netifd shows wwan up with the IPv4 call the incident began with (0); else 1, and
# LK_ENDED is 2 (wwan is down) or 3 (another session, or no IPv4 call any more). It runs before
# every modem call, signal to udhcpc and escalation. Another call of the session, once seen in this
# incident, stays in LK_SIB, whatever the data says later (R49c, D196).
lk_own() {
    [ -z "$LK_ENDED" ] || return 1
    if ! lk_netifd; then
        LK_ENDED=2
        return 1
    fi
    if ! lk_native4 || ! lk_same "$LK_SID0" "$LK_BIRTH0"; then
        LK_ENDED=3
        return 1
    fi
    [ -z "$LK_CID6$LK_PDH6" ] || LK_SIB=1
    return 0
}

# lk_call LABEL MS ARGS...: lk_uqmi after the ownership check; nothing is asked of the modem when
# the session is not ours any more (LK_ENDED says so).
lk_call() {
    lk_own || return 1
    lk_uqmi "$@" || :
}

# lk_dev_addr DEVICE: the first IPv4 address of the network device.
lk_dev_addr() {
    ip -4 -o addr show dev "$1" 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n 1
}

# lk_run_ok: $LK_RUN made (0700) and a directory of root, no link
lk_run_ok() {
    { (umask 077 && mkdir -p "$LK_RUN") && lw_state_dir_ok "$LK_RUN"; } 2>/dev/null
}

lk_paused() {
    [ -f "$LK_RUN/pause_until" ] && lw_state_dir_ok "$LK_RUN" || return 1
    read -r _lk_until <"$LK_RUN/pause_until"
    lk_cs
    [ $((LK_CS / 100)) -lt "${_lk_until:-0}" ] && return 0
    rm -f "$LK_RUN/pause_until"
    lk_dbg "pause is over, watching again"
    return 1
}

# lk_note_restore: R49e. A restore that does not hold (3 within 10 min, as with an exhausted data
# plan) is left to watchcat and wwan-recover for 10 min.
lk_note_restore() {
    lk_cs
    _lk_now=$((LK_CS / 100))
    lk_run_ok || return 0
    _lk_keep=
    for _lk_t in $(cat "$LK_RUN/restores" 2>/dev/null) "$_lk_now"; do
        [ $((_lk_now - _lk_t)) -gt "$LK_BRAKE_WINDOW" ] || _lk_keep="$_lk_keep $_lk_t"
    done
    # shellcheck disable=SC2086  # a list of numbers
    set -- $_lk_keep
    if [ "$#" -ge "$LK_BRAKE_COUNT" ]; then
        echo $((_lk_now + LK_BRAKE_PAUSE)) >"$LK_RUN/pause_until"
        rm -f "$LK_RUN/restores"
        lw_log "$LK_TAG" "$# restores in $((LK_BRAKE_WINDOW / 60)) min, pausing for $((LK_BRAKE_PAUSE / 60)) min"
    else
        printf '%s\n' "$@" >"$LK_RUN/restores"
    fi
}

# lk_snapshot: R49g, the modem's own view after a restore, through the image's AT helper and lock.
# It comes after the outcome line, so it never delays the restore; it stops at the first command
# that gets no answer, like the recovery snapshot (R20a).
lk_snapshot() {
    lw_is_debug || return 0
    for _lk_c in 'AT+CEER' 'AT+CEREG?' 'AT+CGATT?' 'AT+CGACT?' 'AT+CGPADDR=1'; do
        _lk_r=$(lw_at "$LK_AT_LIMIT" "$_lk_c") || {
            lk_dbg "AT snapshot stopped at $_lk_c: no answer within $LK_AT_LIMIT s"
            return 0
        }
        lk_dbg "AT snapshot $_lk_c: $(lk_ascii "$_lk_r")"
    done
}

# lk_v6_silent: R49d, true only when a family check of this very session, taken after the loss was
# seen, got no IPv6 answer. The checks write one line to $LK_V6_RESULT: the session (client/handle
# of the IPv4 call as netifd published it), its birth (or -), the second on the clock of
# common.sh when the check's IPv6 pings started (R14g), and `answer` or `none`. A missing or
# unreadable file, another word, an older check, one of another session, a file in a directory that
# is not root's: not silent, so the sibling is kept (D196).
lk_v6_silent() {
    lw_state_dir_ok "${LK_V6_RESULT%/*}" || return 1
    [ -r "$LK_V6_RESULT" ] || return 1
    _lk_rs='' _lk_rb='' _lk_rt='' _lk_rr=''
    read -r _lk_rs _lk_rb _lk_rt _lk_rr <"$LK_V6_RESULT" || :
    [ "$_lk_rr" = none ] || return 1
    case $_lk_rt in '' | *[!0-9]*) return 1 ;; esac
    # a birth that is not a number would end the shell in lk_same's arithmetic
    case $_lk_rb in -) ;; '' | *[!0-9]*) return 1 ;; esac
    lk_same "$_lk_rs" "$_lk_rb" || return 1
    [ "$_lk_rt" -ge $((LK_T0 / 100)) ]
}

# lk_ended: an incident that stops because the session is not ours (R49f).
lk_ended() {
    if [ "$LK_ENDED" = 2 ]; then
        lk_elapsed
        lw_log "$LK_TAG" "data session lost, netifd took $LK_IFACE down after $LK_EL s, nothing more to do"
    else
        lw_log "$LK_TAG" "data session lost, the session changed, nothing more to do"
    fi
}

# lk_escalate REASON: R49d. One `ifup wwan`, then nothing more for this incident: the marker stays
# until a pass sees the session healthy. While another call of the session may exist, `ifup` goes
# out only on a session-matched IPv6 result of silence; otherwise the incident ends with IPv6 kept
# (D177, D196, D200). The marker names the session, so another session is not held by it (R49h).
lk_escalate() {
    if ! lk_own; then
        lk_ended
        return
    fi
    ! lk_run_ok || echo "$LK_SID0 ${LK_BIRTH0:--}" >"$LK_RUN/escalated"
    if [ -n "$LK_SIB" ] && ! lk_v6_silent; then
        lw_log "$LK_TAG" "data session lost, $1, IPv6 kept, no ifup"
        return
    fi
    lw_log "$LK_TAG" "data session lost, $1, ifup $LK_IFACE"
    timeout 20 ifup "$LK_IFACE"
}

lk_restored() {
    lk_elapsed
    if [ -n "$LK_UNREG" ]; then
        _lk_how="data session lost, modem was not registered at first"
    else
        _lk_how="data session lost with the modem registered"
    fi
    _lk_h=
    if [ -n "$LK_HANDLE" ] && [ "$LK_HANDLE" != "$LK_PDH" ]; then
        # qmi.sh clears the client with 0xffffffff, not by handle, so the stale pdh_4 does no harm
        # and netifd's data is left alone (D80)
        _lk_h=", new data handle $LK_HANDLE (netifd has ${LK_PDH:-none})"
    fi
    lw_log "$LK_TAG" "$_lk_how, restored in place after $LK_EL s, address ${LK_OLD:-none} -> $LK_NEW$_lk_h"
    lk_note_restore
    lk_snapshot
}

# lk_release_wait ADDRESS: after USR2, wait until udhcpc has handled the release, so that USR1 does
# not arrive with USR2 still pending (two pending signals come in number order, USR1 first: udhcpc
# would renew and then release, and end without an address). The sign of the release is the address
# leaving the device (udhcpc runs its deconfig script inside the release, and netifd removes the
# address). Up to LK_RELEASE_LOOKS looks, about 8 ms each on the router, where sleep takes whole
# seconds only; when the address is still there after that, or there was none to watch, one second.
lk_release_wait() {
    _lk_l=0
    if [ -n "$1" ]; then
        while [ "$_lk_l" -lt "$LK_RELEASE_LOOKS" ]; do
            _lk_a=$(lk_dev_addr "$LK_NET")
            if [ "$_lk_a" != "$1" ]; then
                lk_idbg "address of $LK_NET released after $_lk_l looks"
                return 0
            fi
            _lk_l=$((_lk_l + 1))
        done
        lk_idbg "address $1 still on $LK_NET after $_lk_l looks, waiting 1 s"
    else
        lk_idbg "no address on $LK_NET to watch, waiting 1 s"
    fi
    sleep 1
}

# lk_dhcp_kick: release and then renew the lease of the device. A renew alone asks the old server
# first and takes about 13 s (measured); release first gives the new lease within a second.
# The pid file is netifd's own; the name check keeps a stale pid file from sending a signal that
# kills some other process.
lk_dhcp_kick() {
    if [ -n "$LK_STATIC" ]; then
        # R73p: dhcp is 0, netifd holds a static address and no udhcpc runs for it
        lk_elapsed
        [ "$LK_KICK_AT" -ge 0 ] || lk_idbg "static IPv4 (dhcp 0), no lease to renew"
        LK_KICK_AT=$LK_EL
        return 0
    fi
    lk_own || return 1
    _lk_pf=/var/run/udhcpc-$LK_NET.pid
    _lk_pid=
    [ ! -r "$_lk_pf" ] || read -r _lk_pid <"$_lk_pf"
    case $_lk_pid in '' | *[!0-9]*)
        lk_idbg "no udhcpc pid in $_lk_pf"
        return 1
        ;;
    esac
    if [ "$(cat "/proc/$_lk_pid/comm" 2>/dev/null)" != udhcpc ]; then
        lk_idbg "pid $_lk_pid from $_lk_pf is not udhcpc"
        return 1
    fi
    _lk_before=$(lk_dev_addr "$LK_NET")
    "$LK_KILL" -USR2 "$_lk_pid" || return 1
    lk_release_wait "$_lk_before"
    # the release took a moment: only a session seen to be another one loses the renew; after a
    # failed status read or with wwan down the released udhcpc would otherwise sit without an
    # address until watchcat acts, and a renew on a dying udhcpc does no harm (R49c, R49h)
    if ! lk_own && [ "$LK_ENDED" = 3 ]; then
        return 1
    fi
    [ "$(cat "/proc/$_lk_pid/comm" 2>/dev/null)" = udhcpc ] || return 1
    "$LK_KILL" -USR1 "$_lk_pid" || return 1
    lk_elapsed
    LK_KICK_AT=$LK_EL
    lk_idbg "udhcpc $_lk_pid released and asked for a new lease"
}

# lk_start: one try to start the call again on netifd's client. The arguments are those of qmi.sh,
# each only when the option of network.wwan is set.
lk_start() {
    lk_call serving 3000 --get-serving-system
    [ -z "$LK_ENDED" ] || return
    _lk_reg=$(printf '%s\n' "$LK_OUT" | jsonfilter -e '@.registration' 2>/dev/null)
    if [ "$_lk_reg" != registered ]; then
        LK_UNREG=1
        lk_idbg "modem registration '${_lk_reg:-no answer}', waiting"
        return
    fi
    set -- --set-client-id "wds,$LK_CID" --start-network
    for _lk_o in apn:--apn profile:--profile auth:--auth-type username:--username password:--password; do
        _lk_v=$(uci -q get "network.$LK_IFACE.${_lk_o%%:*}")
        [ -z "$_lk_v" ] || set -- "$@" "${_lk_o#*:}" "$_lk_v"
    done
    # R73g: the IPv4 call has the autoconnect unless the option is 0
    [ "$(uci -q get "network.$LK_IFACE.autoconnect")" = 0 ] || set -- "$@" --autoconnect
    lk_call start 5000 "$@"
    [ -z "$LK_ENDED" ] || return
    # uqmi prints the handle as a signed number: -882662896 on the router
    case ${LK_OUT#-} in '' | *[!0-9]*)
        lk_idbg "start-network answered '$(lk_ascii "$LK_OUT")'"
        # qmi.sh clears this state the same way before it tries again; the wildcard stop is for a
        # session with this call alone (R49c, D196): next to another call it may take that down too
        if [ "$LK_OUT" = '"No effect"' ] && lk_own && [ -z "$LK_SIB" ]; then
            lk_uqmi clear 3000 --set-client-id "wds,$LK_CID" --stop-network 0xffffffff --autoconnect
        fi
        return
        ;;
    esac
    LK_HANDLE=$LK_OUT
    lk_idbg "start-network gave handle $LK_HANDLE"
    lk_dhcp_kick
    LK_WAIT=$LK_SETTLE
}

# lk_verify: the call is up; done (0) when the device has the address the modem reports, else the
# lease is renewed again every LK_KICK_EVERY seconds.
lk_verify() {
    lk_call settings 3000 --set-client-id "wds,$LK_CID" --get-current-settings
    [ -z "$LK_ENDED" ] || return 1
    LK_NEW=$(printf '%s\n' "$LK_OUT" | jsonfilter -e '@.ipv4.ip' 2>/dev/null)
    if [ -z "$LK_NEW" ]; then
        lk_idbg "connected, no IPv4 address in the settings ('$(lk_ascii "$LK_OUT")')"
        return 1
    fi
    _lk_cur=$(lk_dev_addr "$LK_NET")
    if [ "$_lk_cur" = "$LK_NEW" ]; then
        lk_idbg "connected, device has the address of the call, $LK_NEW"
        return 0
    fi
    lk_idbg "connected, modem address $LK_NEW, device has ${_lk_cur:-none}"
    lk_elapsed
    if [ $((LK_EL - LK_KICK_AT)) -ge "$LK_KICK_EVERY" ]; then
        lk_dhcp_kick
        LK_WAIT=$LK_SETTLE
    fi
    return 1
}

# lk_step: one look and, when needed, one action. 0 = restored, 1 = not yet, 2 = netifd took wwan
# down meanwhile (someone restarted the interface, so the session is not ours any more); a session
# that is not ours also sets LK_ENDED, which lk_incident reads first.
lk_step() {
    lk_call data 3000 --set-client-id "wds,$LK_CID" --get-data-status || return 1
    case $LK_OUT in
        '"connected"')
            lk_verify
            return
            ;;
        '"disconnected"') lk_start ;;
        *) lk_idbg "data status '$(lk_ascii "$LK_OUT")', waiting" ;;
    esac
    return 1
}

# lk_incident: from the first sight of the loss until restored, abandoned or given up (R49c, R49d).
lk_incident() {
    lk_cs
    LK_T0=$LK_CS
    LK_KICK_AT=-100
    LK_HANDLE='' LK_NEW='' LK_UNREG='' LK_SIB='' LK_STATIC=''
    [ -z "$LK_CID6$LK_PDH6" ] || LK_SIB=1
    [ "$(uci -q get "network.$LK_IFACE.dhcp")" != 0 ] || LK_STATIC=1
    LK_NET=$LK_L3
    if [ -z "$LK_NET" ]; then
        LK_NET=$(timeout 5 ifstatus "${LK_IFACE}_4" 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
    fi
    LK_OLD=
    [ -z "$LK_NET" ] || LK_OLD=$(lk_dev_addr "$LK_NET")
    lk_idbg "lost: data status disconnected, settings Out of call, device ${LK_NET:-unknown}, address ${LK_OLD:-none}, client $LK_CID, handle ${LK_PDH:-none}"
    if [ -z "$LK_NET" ]; then
        lk_escalate "no network device name from netifd"
        return
    fi
    while :; do
        lk_elapsed
        if [ "$LK_EL" -ge "$LK_GIVE_UP" ]; then
            lk_escalate "not restored in place after $LK_EL s"
            return
        fi
        LK_WAIT=$LK_STEP
        _lk_s=0
        lk_step || _lk_s=$?
        if [ -n "$LK_ENDED" ]; then
            lk_ended
            return
        fi
        case $_lk_s in
            0)
                lk_restored
                return
                ;;
        esac
        lk_nap "$LK_WAIT"
    done
}

lk_healthy() {
    if [ -f "$LK_RUN/escalated" ] && lw_state_dir_ok "$LK_RUN"; then
        rm -f "$LK_RUN/escalated"
        lk_dbg "data session healthy again after the escalation"
    fi
    LK_NOTED=
}

# lk_v6_reload: R74f. The LAN follows the flag: the init script reads the session and the flag again
# and withdraws or advertises the prefix (R74c). It takes a few seconds on a loss (two reloads of
# odhcpd with a wait between), and its exit status says that the change reached odhcpd. The marker
# v6reload stays until a reload succeeded, so a watcher killed after the flag changed does it on its
# next pass, and a failed reload is tried again (lk_replay).
lk_v6_reload() {
    timeout -k 2 20 "$LK_LAN6" reload lan6 >/dev/null 2>&1 || return 1
    rm -f "$LK_RUN/v6reload"
}

# lk_replay: R74f, R74c. Finishes what an earlier reload left undone, with no new event of the
# session: the LAN's own pending mark (a signal that did not reach odhcpd, a withdrawal cut off
# between its two advertisements) or the watcher's marker. Two builtin tests per pass when there is
# nothing to do, which is every pass of an IPv4-only router; an attempt at most every LK_REPLAY seconds.
lk_replay() {
    [ -e "$LK_LAN6_PENDING" ] || { [ -e "$LK_RUN/v6reload" ] && lw_state_dir_ok "$LK_RUN"; } || return 0
    lk_cs
    [ -z "$LK_REPLAY_AT" ] || [ $((LK_CS - LK_REPLAY_AT)) -ge $((LK_REPLAY * 100)) ] || return 0
    LK_REPLAY_AT=$LK_CS
    lk_v6_reload || lk_dbg "the reload of the LAN did not finish, tried again later"
}

# lk_v6_own: R49a, R49h for the IPv6 call. Before each request for it and before the flag changes:
# netifd still shows wwan up with the IPv4 call of the pass and the same IPv6 call (client and
# handle), the modem device still exists, and no start is negotiating. A new reading of netifd,
# so a change that came while the last request was answered is seen.
lk_v6_own() {
    lk_own || return 1
    [ -e "$LK_DEV" ] || return 1
    if [ "$LK_CID6/$LK_PDH6" != "$LK_V6ID0" ]; then
        LK_ENDED=3
        return 1
    fi
    lk_cs
    if lw_negotiation_deadline "$LW_FAMILY_DIR/negotiating" "$((LK_CS / 100))" >/dev/null; then
        LK_ENDED=3
        return 1
    fi
}

# lk_v6_flag: R74f. The flag of this session in LK_V6L: lost, or empty (none, or one of another call
# or of an earlier start of the interface, which is removed). Needs LK_CID6 and LK_PDH6.
lk_v6_flag() {
    LK_V6L=
    [ -f "$LK_RUN/v6lost" ] && lw_state_dir_ok "$LK_RUN" || return 0
    _lk_fk='' _lk_fb=''
    read -r _lk_fk _lk_fb _ <"$LK_RUN/v6lost" || :
    if [ "$_lk_fk" = "$LK_CID6/$LK_PDH6" ] && lk_same "$LK_SID" "$_lk_fb"; then
        LK_V6L=lost
    else
        rm -f "$LK_RUN/v6lost"
    fi
}

# lk_v6_set lost|back: R74f. The marker first, then the flag, then the reload: whatever stops the
# watcher in between, the next pass finishes it.
lk_v6_set() {
    lk_run_ok || return 1
    : >"$LK_RUN/v6reload" || return 1
    if [ "$1" = lost ]; then
        printf '%s %s\n' "$LK_CID6/$LK_PDH6" "${LK_BIRTH:--}" >"$LK_RUN/v6lost.new" &&
            mv -f "$LK_RUN/v6lost.new" "$LK_RUN/v6lost" || return 1
    else
        rm -f "$LK_RUN/v6lost" || return 1
    fi
    lk_v6_reload || :
}

# lk_v6_watch: R74f, R49i. With the IPv4 call healthy and an IPv6 call in netifd's data, read the
# state of that call (one uqmi call, on its own client, -t and timeout like every other). A
# disconnect that the settings confirm (`"Out of call"`, as for IPv4 in R49b) switches the LAN's IPv6
# off once and logs one line; the call connected again switches it back on. Any other answer, an
# empty one, a failing call or a timeout changes nothing. IPv4 is never touched (R49i), and a session
# without an IPv6 call makes no call at all (two builtin tests). The session is checked again before
# each request and before the flag changes (lk_v6_own).
lk_v6_watch() {
    case $LK_CID6 in '' | *[!0-9]*) return 0 ;; esac
    case ${LK_PDH6#-} in '' | *[!0-9]*) return 0 ;; esac
    LK_V6ID0=$LK_CID6/$LK_PDH6
    lk_v6_own || return 0
    lk_v6_flag
    lk_uqmi data6 3000 --set-client-id "wds,$LK_CID6" --get-data-status || :
    case $LK_OUT in
        '"connected"')
            [ "$LK_V6L" = lost ] || return 0
            lk_v6_own || return 0
            lk_v6_set back || return 0
            lw_log "$LK_TAG" "IPv6 call connected again, the LAN follows the session again"
            ;;
        '"disconnected"')
            [ "$LK_V6L" != lost ] || return 0
            lk_v6_own || return 0
            lk_uqmi settings6 3000 --set-client-id "wds,$LK_CID6" --get-current-settings || :
            [ "$LK_OUT" = '"Out of call"' ] || return 0
            lk_v6_own || return 0
            lk_v6_set lost || return 0
            lw_log "$LK_TAG" "IPv6 call lost, IPv4 kept, the LAN stops advertising IPv6"
            ;;
        *) lk_dbg "IPv6 data status: no usable answer '$(lk_ascii "$LK_OUT")', no action" ;;
    esac
}

# lk_pass: R49, R49a, R49b. Only the exact answers of the measured failure start an incident;
# anything else, a hung or confused uqmi included, changes nothing.
lk_pass() {
    LK_PASSES=$((LK_PASSES + 1))
    lk_replay
    lk_netifd || return 0
    # R49a, D177: the session decides, not the configured pdptype. Without a native IPv4 call in
    # netifd's data (an IPv6-only session, or a start that has not published yet) no call at all.
    lk_native4 || return 0
    lk_cs
    if lw_negotiation_deadline "$LW_FAMILY_DIR/negotiating" "$((LK_CS / 100))" >/dev/null; then
        return 0
    fi
    LK_DEV=$(uci -q get "network.$LK_IFACE.device")
    [ -n "$LK_DEV" ] || LK_DEV=/dev/cdc-wdm0
    [ -e "$LK_DEV" ] || return 0
    ! lk_paused || return 0
    # R49h: this is the session of the pass, and of the incident that may follow
    LK_ENDED='' LK_SID0=$LK_SID LK_BIRTH0=$LK_BIRTH
    lk_uqmi data 3000 --set-client-id "wds,$LK_CID" --get-data-status
    case $LK_OUT in
        '"connected"')
            lk_healthy
            lk_v6_watch
            return 0
            ;;
        '"disconnected"') ;;
        *)
            lk_dbg "data status: no usable answer '$(lk_ascii "$LK_OUT")', no action"
            return 0
            ;;
    esac
    lk_call settings 3000 --set-client-id "wds,$LK_CID" --get-current-settings
    [ -z "$LK_ENDED" ] || return 0
    if [ "$LK_OUT" != '"Out of call"' ]; then
        lk_dbg "data status disconnected but settings answer '$(lk_ascii "$LK_OUT")', no action"
        return 0
    fi
    if [ -f "$LK_RUN/escalated" ] && lw_state_dir_ok "$LK_RUN"; then
        _lk_ms='' _lk_mb=''
        read -r _lk_ms _lk_mb <"$LK_RUN/escalated" || :
        if lk_same "$_lk_ms" "$_lk_mb"; then
            [ -n "$LK_NOTED" ] || lk_dbg "session still lost, no action after the escalation until it is healthy"
            LK_NOTED=1
            return 0
        fi
        # R49h: the marker is that of an earlier session (a start gave the same numbers again, or
        # the service was replaced); this session is a new incident
        rm -f "$LK_RUN/escalated"
        LK_NOTED=
        lk_dbg "the escalation was for another session, watching this one"
    fi
    lk_incident
}

# lk_heartbeat: R49g, a line every LK_HEARTBEAT seconds at the debug level, so a quiet log still
# shows that the watcher runs and how the modem answers.
lk_heartbeat() {
    lw_is_debug || return 0
    lk_cs
    [ $((LK_CS - LK_HB_AT)) -ge $((LK_HEARTBEAT * 100)) ] || return 0
    lk_dbg "heartbeat: $LK_PASSES passes, $LK_BAD failed or slow uqmi calls, slowest answer $((LK_SLOWEST * 10)) ms"
    LK_PASSES=0 LK_BAD=0 LK_SLOWEST=0
    LK_HB_AT=$LK_CS
}

# lk_run: LW_LINKWATCH_PASSES (tests) ends the loop after that many passes.
lk_run() {
    trap '[ -z "$LK_NAP" ] || kill "$LK_NAP" 2>/dev/null; exit 0' TERM INT
    lk_cs
    LK_HB_AT=$LK_CS
    _lk_n=0
    while :; do
        lk_pass
        lk_heartbeat
        _lk_n=$((_lk_n + 1))
        [ "${LW_LINKWATCH_PASSES:-0}" = 0 ] || [ "$_lk_n" -lt "$LW_LINKWATCH_PASSES" ] || break
        lk_nap "$LK_PERIOD"
    done
}

case ${1:-} in
    run | once) ;;
    *)
        echo "usage: lw-linkwatch run|once" >&2
        exit 2
        ;;
esac
# the level is read here once, in this shell, so lw_debug never forks uci (R29c)
lw_is_debug || :
case $1 in
    run) lk_run ;;
    once) lk_pass ;;
esac
