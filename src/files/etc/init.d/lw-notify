#!/bin/sh /etc/rc.common
# Telegram notifications and SMS control as one procd service, restarted after a crash (SPEC R38,
# R46d). It starts with a bot token and chat in uci lonewrt.notify, or with SMS admins in
# lonewrt.notify.sms_admins, or both; without any of them (the default image) it starts no instance at
# all, so the router runs as without notifications (R38a, D43). A profile with only one of token and
# chat leaves a marker at first boot, and this script logs once that the Telegram part is off.

# shellcheck disable=SC2034  # read by /etc/rc.common
START=99
# shellcheck disable=SC2034
USE_PROCD=1

LWN_PARTIAL=/etc/lw-notify.partial

start_service() {
    _tg=1
    if [ -z "$(uci -q get lonewrt.notify.token)" ] || [ -z "$(uci -q get lonewrt.notify.chat)" ]; then
        _tg=0
        if [ -f "$LWN_PARTIAL" ]; then
            logger -t lw-notify -p daemon.notice \
                "notifications off: the profile sets only one of TG_BOT_TOKEN and TG_CHAT_ID"
            rm -f "$LWN_PARTIAL"
        fi
    fi
    [ "$_tg" = 1 ] || [ -n "$(uci -q get lonewrt.notify.sms_admins)" ] || return 0
    procd_open_instance
    procd_set_param command /usr/sbin/lw-notify run
    # restart after every crash: threshold 3600 s, 5 s pause, no retry limit
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
