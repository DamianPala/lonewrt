#!/bin/sh /etc/rc.common
# The data session watcher as a procd service, restarted after a crash (SPEC R49, D80). It makes no
# uqmi call while netifd shows wwan as down, so starting it before the interface is up does no harm;
# START is after the network (20) all the same.

# shellcheck disable=SC2034  # read by /etc/rc.common
START=98
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/lw-linkwatch run
    # restart after every crash: threshold 3600 s, 5 s pause, no retry limit
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
