#!/bin/sh /etc/rc.common
# Puts the modem back into its configured state on every boot (SPEC R10, R11): LTE-only, bands from
# lonewrt.modem.bands, SMS store ME. These live in modem NVRAM, which neither a reboot nor a reset of
# OpenWrt touches, so whatever a test or the EDGE fallback left behind would stay.
# The uci part runs before netifd (START 20), so its first ifup already asks for LTE; the AT part
# runs in the background, so a silent modem never delays boot or blocks LAN and SSH (R8).
# rc.common sources this file, hence the lwmm_ prefix on everything.

# shellcheck disable=SC2034  # read by /etc/rc.common
START=19

# shellcheck source=src/files/usr/lib/lw/common.sh
. /usr/lib/lw/common.sh

LWMM_TAG=lw-modem-mode
LWMM_RUN_LOCK=/tmp/lw-modem-mode.lock
# Delays and the AT limit in seconds; tests shorten them through the environment.
LWMM_PORT_WAIT=${LW_MODEM_PORT_WAIT:-120}
LWMM_SETTLE=${LW_MODEM_SETTLE:-60}
LWMM_RETRY=${LW_MODEM_RETRY:-30}
LWMM_AT_LIMIT=${LW_MODEM_AT_LIMIT:-20}

# lwmm_mask LIST: "1,3,8,20,28,32" -> 88080085, bit n-1 is band n (R12). Fails on anything but
# whole band numbers 1 to 64.
lwmm_mask() {
    _m=0
    for _b in $(printf '%s' "$1" | tr ',' ' '); do
        case $_b in '' | *[!0-9]*) return 1 ;; esac
        _b=${_b#"${_b%%[!0]*}"} # leading zeros would read as octal
        [ -n "$_b" ] && [ "$_b" -le 64 ] || return 1
        _m=$((_m | (1 << (_b - 1))))
    done
    [ "$_m" != 0 ] || return 1
    printf '%X\n' "$_m"
}

# lwmm_hex VALUE: upper case without leading zeros, so masks compare as strings.
lwmm_hex() {
    printf '%s' "$1" | tr 'a-f' 'A-F' | sed 's/^0*//'
}

# lwmm_at COMMAND: answer in LWMM_OUT; fails only when the command ran out of time (R12b).
lwmm_at() {
    _arc=0
    LWMM_OUT=$(lw_at "$LWMM_AT_LIMIT" "$1") || _arc=$?
    [ "$_arc" != 124 ]
}

# lwmm_read MASK: reads mode, band mask (only with a target MASK) and SMS stores into LWMM_MODE,
# LWMM_BANDS, LWMM_SMS. Returns 0 when all match, 1 when not, 124 on an AT timeout.
lwmm_read() {
    lwmm_at 'AT+ZSNT?' || return 124
    LWMM_MODE=$(printf '%s\n' "$LWMM_OUT" | sed -n 's/^+ZSNT: *//p' | tr -d ' ')
    LWMM_BANDS=
    if [ -n "$1" ]; then
        lwmm_at 'AT+ZNLOCKBAND?' || return 124
        LWMM_BANDS=$(printf '%s\n' "$LWMM_OUT" | sed -n 's/^+ZNLOCKBAND: *\([0-9A-Fa-f]*\).*/\1/p')
    fi
    lwmm_at 'AT+CPMS?' || return 124
    LWMM_SMS=$(printf '%s\n' "$LWMM_OUT" | sed -n 's/^+CPMS: *//p')
    [ "$LWMM_MODE" = 6,0,0 ] || return 1
    [ -z "$1" ] || [ "$(lwmm_hex "$LWMM_BANDS")" = "$1" ] || return 1
    case $LWMM_SMS in '"ME",'*',"ME",'*',"ME",'*) return 0 ;; esac
    return 1
}

# lwmm_attempt MASK: one attempt. The SMS store command goes every time; mode and bands only get a
# set command when they differ (R11a). Returns as lwmm_read after the fix.
lwmm_attempt() {
    lwmm_at 'AT+CPMS="ME","ME","ME"' || return 124
    _rc=0
    lwmm_read "$1" || _rc=$?
    [ "$_rc" = 1 ] || return "$_rc"
    if [ "$LWMM_MODE" != 6,0,0 ]; then
        lw_log "$LWMM_TAG" "mode '${LWMM_MODE:-no answer}', setting LTE-only (6,0,0)"
        lwmm_at 'AT+ZSNT=6,0,0' || return 124
    fi
    if [ -n "$1" ] && [ "$(lwmm_hex "$LWMM_BANDS")" != "$1" ]; then
        lw_log "$LWMM_TAG" "band mask '${LWMM_BANDS:-no answer}', setting $1"
        lwmm_at "AT+ZNLOCKBAND=1,0,$1,0" || return 124
    fi
    lwmm_read "$1"
}

# lwmm_wait_port: up to LWMM_PORT_WAIT seconds for the AT port (R11b).
lwmm_wait_port() {
    _w=0
    while [ ! -c "$LW_AT_PORT" ]; do
        [ "$_w" -lt "$LWMM_PORT_WAIT" ] || return 1
        sleep 2
        _w=$((_w + 2))
    done
}

lwmm_run() {
    exec 9>"$LWMM_RUN_LOCK"
    flock -n 9 || return 0
    _want=$(uci -q get lonewrt.modem.bands)
    _mask=
    if [ -n "$_want" ]; then
        _mask=$(lwmm_mask "$_want") ||
            lw_log "$LWMM_TAG" "lonewrt.modem.bands '$_want' is not a list of bands 1-64, bands left as they are"
    fi
    if ! lwmm_wait_port; then
        lw_log "$LWMM_TAG" "no AT port $LW_AT_PORT after $LWMM_PORT_WAIT s, modem state not checked until next boot"
        return 0
    fi
    # netifd and the Auto-APN script talk to the modem right after the port appears
    sleep "$LWMM_SETTLE"
    _n=1
    while :; do
        _rc=0
        lwmm_attempt "$_mask" || _rc=$?
        if [ "$_rc" = 0 ]; then
            lw_log "$LWMM_TAG" "modem OK: mode 6,0,0, bands ${_mask:-untouched}, SMS store ME (attempt $_n)"
            return 0
        fi
        [ "$_n" -lt 3 ] || break
        _n=$((_n + 1))
        sleep "$LWMM_RETRY"
    done
    if [ "$_rc" = 124 ]; then
        _why="AT command timed out"
    else
        _why="mode '${LWMM_MODE:-no answer}' bands '${LWMM_BANDS:-${_mask:+no answer}}' sms '${LWMM_SMS:-no answer}'"
    fi
    lw_log "$LWMM_TAG" "modem state still differs after 3 attempts ($_why), not retried until next boot"
}

start() {
    _modes=$(uci -q get network.wwan.modes)
    if uci -q get network.wwan >/dev/null && [ "$_modes" != lte ]; then
        uci -q set network.wwan.modes=lte && uci -q commit network &&
            lw_log "$LWMM_TAG" "network.wwan.modes '${_modes:-unset}' set to lte (EDGE fallback ends at boot)"
    fi
    (lwmm_run) </dev/null >/dev/null 2>&1 &
}
