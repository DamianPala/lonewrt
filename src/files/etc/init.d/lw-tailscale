#!/bin/sh /etc/rc.common
# The Tailscale service of the image as a procd service, restarted after a crash (SPEC R63c, D135).
# It is its own service because the settings of R64 must hold before anyone signs in, also without
# Telegram keys and SMS admins, which are what start lw-notify (R38a). START is after the init of the
# package `tailscale` (80), so the daemon is up or on its way; the service waits for its answer anyway.
# A crash of Tailscale or of this service touches nothing else (R63e, D157).

# shellcheck disable=SC2034  # read by /etc/rc.common
START=81
# shellcheck disable=SC2034
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/sbin/lw-tailscale run
    # restart after every crash: threshold 3600 s, 5 s pause, no retry limit
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
