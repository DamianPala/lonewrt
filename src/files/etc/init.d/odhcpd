#!/bin/sh /etc/rc.common
# shellcheck disable=SC3043  # local is supported by BusyBox ash.
# R74e: the stock odhcpd instance reads a RAM copy so dnsmasq and persistent UCI stay independent.

# shellcheck disable=SC2034  # read by rc.common
START=35
# shellcheck disable=SC2034
STOP=85
# shellcheck disable=SC2034
USE_PROCD=1

# shellcheck source=src/files/usr/lib/lw/lan6.sh
. /usr/lib/lw/lan6.sh

start_service() {
    # R74b: without the RAM copy odhcpd reads the persistent config, which is quiet on lan.
    set -- /usr/sbin/odhcpd
    if lan6_configure boot; then set -- "$@" -c "$LW_LAN6_CONFIG"; fi
    procd_open_instance
    procd_set_param command "$@"
    procd_set_param respawn
    procd_close_instance
}

reload_service() {
    local change
    change=$(lan6_configure event) || return 1
    [ "$1" != lan6 ] || [ "$change" = reload ] || return 0
    procd_send_signal odhcpd
}

service_triggers() {
    procd_add_reload_trigger dhcp network system
}
